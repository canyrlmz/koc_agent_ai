# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.

# mock = API anahtarı olmadan demo, gemini / claude = gerçek analiz
LLM_PROVIDER=mock
# Google AI Studio (ücretsiz katman; gerçek danışan verisi göndermeyin)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Ana modelin günlük ücretsiz kotası dolunca sırayla denenecek modeller
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# mock = hazır örnek diyalog, whisper = yüklenen kaydın gerçek transkripti
TRANSCRIBE_MODE=mock
# tiny/base hızlı ama zayıf; small iyi denge; medium/large-v3 daha doğru ama yavaş
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=tr

# openalex = gerçek akademik yayın araması (ücretsiz, anahtar gerekmez), mock = örnek makaleler
RESEARCH_MODE=openalex
# Ücretsiz anahtar: https://openalex.org/settings/api (anahtarsız kota çok küçük)
OPENALEX_API_KEY=

# --- Veritabanı: boş = SQLite (data/koc_agent.db). Çok kullanıcılı kurulum için PostgreSQL:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/farkora
DATABASE_URL=

# Gözlemci bağlantısı ve e-postalardaki adres
PUBLIC_BASE_URL=http://127.0.0.1:8765
# Eğer–o zaman planından kaç gün sonra ajan "oldu mu?" diye sorsun
COMMITMENT_CHECK_DAYS=3

# --- E-posta (boş = gönderilmez, giden kutusuna "simüle" yazılır)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- WhatsApp Business Cloud API (Meta). İşletmenin başlattığı mesaj için onaylı şablon gerekir.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=tr

# --- Toplantı botu (Zoom / Teams / Meet). Boş = simülasyon. https://docs.recall.ai
RECALL_API_KEY=
RECALL_REGION=us-east-1
MEETING_BOT_NAME=Farkora Not Asistanı
